# ── UMKM ONLINE — Environment Variables ──────────────────────────────────────
# Copy file ini menjadi "umkm.env" di VPS, lalu isi nilai yang sebenarnya.
# File "umkm.env" TIDAK boleh di-commit ke git (sudah ada di .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=production

# Database — Supabase pooler (port 6543, untuk runtime)
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
CUSTOMER_JWT_SECRET=
CUSTOMER_JWT_EXPIRES_IN=30d

# Default accounts (seed)
ADMIN_DEFAULT_PASSWORD=
CUSTOMER_DEFAULT_PASSWORD=

# Store
STORE_ID_DEFAULT=

# Order expiry
ORDER_EXPIRY_MINUTES=1440
ORDER_EXPIRY_CRON_MINUTES=60
