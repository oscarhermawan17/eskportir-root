PORT=4000
NODE_ENV=production

# Database — Supabase pooler (port 6543, untuk runtime)
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
CUSTOMER_JWT_SECRET=

# Default accounts (seed)
ADMIN_DEFAULT_PASSWORD=
CUSTOMER_DEFAULT_PASSWORD=

# Store
STORE_ID_DEFAULT=

# Order expiry
ORDER_EXPIRY_MINUTES=30
ORDER_EXPIRY_CRON_MINUTES=5

# Email via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_ENABLED=true
RESEND_FROM=
